// Lumina Database Schema
// Comprehensive schema for salon/barbershop management platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String? // For email/password auth
  role          UserRole  @default(STAFF)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts         Account[]
  sessions         Session[]
  businesses       BusinessUser[]
  staffProfile     Staff?
  appointments     Appointment[]     @relation("AppointmentClient")
  transactions     Transaction[]
  staffInvitations StaffInvitation[]
  SecurityLog      SecurityLog[]
  AuditLog         AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// BUSINESS MANAGEMENT
// ============================================================================

model Business {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  // Contact Information
  email   String?
  phone   String?
  website String?

  // Address
  address  String?
  city     String?
  state    String?
  zipCode  String?
  country  String  @default("US")
  timezone String  @default("America/New_York")

  // Business Settings
  financialModel FinancialModel @default(COMMISSION)
  currency       String         @default("USD")

  // Booking Settings
  bookingEnabled          Boolean  @default(true)
  onlineBooking           Boolean  @default(true)
  requireDeposit          Boolean  @default(false)
  depositAmount           Decimal? @db.Decimal(10, 2)
  cancellationPolicy      String?
  noShowPolicy            String?
  preparationInstructions String?

  // Operating Hours (JSON stored as string)
  operatingHours Json?

  // Branding
  logo         String?
  primaryColor String? @default("#FFD25A")

  // Status
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                      BusinessUser[]
  staff                      Staff[]
  services                   Service[]
  clients                    Client[]
  appointments               Appointment[]
  appointmentStatusHistory   AppointmentStatusHistory[]
  appointmentPreferences     AppointmentPreferences[]
  transactions               Transaction[]
  paymentCalculations        PaymentCalculation[]
  staffInvitations           StaffInvitation[]
  products                   Product[]
  productSales               ProductSale[]
  giftCards                  GiftCard[]
  promotions                 Promotion[]
  marketingCampaigns         MarketingCampaign[]
  loyaltyPrograms            LoyaltyProgram[]
  clientReviews              ClientReview[]
  communicationHistory       CommunicationHistory[]
  businessHours              BusinessHours[]
  businessHolidays           BusinessHoliday[]
  publicBookingConfig        PublicBookingConfig?
  staffAvailability          StaffAvailability[]
  staffAvailabilityOverrides StaffAvailabilityOverride[]
  timeOffRequests            TimeOffRequest[]
  availabilityCache          AvailabilityCache[]
  SecurityLog                SecurityLog[]
  AuditLog                   AuditLog[]
  PerformanceMetric          PerformanceMetric[]
  BusinessMetric             BusinessMetric[]
  StaffNotification          StaffNotification[]
  PublicBookingAuditLog      PublicBookingAuditLog[]
  EmailTemplate              EmailTemplate[]
  EmailPreference            EmailPreference[]
  EmailQueue                 EmailQueue[]
  ReminderConfig             ReminderConfig?

  @@map("businesses")
}

model BusinessUser {
  id         String       @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole @default(STAFF)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@map("business_users")
}

// ============================================================================
// STAFF MANAGEMENT
// ============================================================================

model Staff {
  id         String @id @default(cuid())
  businessId String
  userId     String @unique

  // Staff Information
  firstName   String
  lastName    String
  displayName String
  title       String?
  bio         String?
  avatar      String?

  // Enhanced Employment Configuration
  employmentType    EmploymentType @default(COMMISSION)
  commissionRate    Decimal?       @db.Decimal(5, 2) // Percentage (e.g., 50.00 for 50%)
  chairRentalAmount Decimal?       @db.Decimal(10, 2) // Fixed rental amount
  chairRentalPeriod RentalPeriod?
  baseSalary        Decimal?       @db.Decimal(10, 2) // Optional base salary for commission employees
  hourlyRate        Decimal?       @db.Decimal(10, 2) // For hourly staff (legacy)

  // Employment Period
  startDate DateTime  @default(now())
  endDate   DateTime? // For terminated staff

  // Availability Settings
  isActive              Boolean @default(true)
  acceptsOnlineBookings Boolean @default(true)

  // Working Hours (JSON stored as string)
  workingHours Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business                    Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  services                    StaffService[]
  appointments                Appointment[]
  assignedAppointmentServices AppointmentService[]        @relation("AssignedStaff")
  transactions                Transaction[]
  paymentCalculations         PaymentCalculation[]
  productSales                ProductSale[]
  reviews                     ClientReview[]
  staffAvailability           StaffAvailability[]
  staffAvailabilityOverrides  StaffAvailabilityOverride[]
  timeOffRequests             TimeOffRequest[]
  approvedTimeOffRequests     TimeOffRequest[]            @relation("TimeOffApprover")
  availabilityCache           AvailabilityCache[]
  StaffNotification           StaffNotification[]

  @@index([businessId, employmentType])
  @@index([businessId, isActive])
  @@map("staff")
}

// ============================================================================
// SERVICE MANAGEMENT
// ============================================================================

model Service {
  id         String @id @default(cuid())
  businessId String

  // Service Information
  name        String
  description String?
  category    String?

  // Pricing
  price    Decimal @db.Decimal(10, 2)
  duration Int // Duration in minutes

  // Settings
  isActive Boolean @default(true)
  isOnline Boolean @default(true) // Available for online booking

  // Additional fields for public booking
  prerequisites   String?
  recommendations String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff        StaffService[]
  appointments AppointmentService[]

  @@map("services")
}

model StaffService {
  id        String @id @default(cuid())
  staffId   String
  serviceId String

  // Custom pricing for this staff member (optional)
  customPrice    Decimal? @db.Decimal(10, 2)
  customDuration Int? // Custom duration in minutes

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@map("staff_services")
}

// ============================================================================
// CLIENT MANAGEMENT
// ============================================================================

model Client {
  id         String @id @default(cuid())
  businessId String

  // Personal Information
  firstName String
  lastName  String
  email     String?
  phone     String?

  // Address (optional)
  address String?
  city    String?
  state   String?
  zipCode String?

  // Client Preferences
  preferredStaff String? // Staff ID
  notes          String?

  // Marketing Preferences
  emailMarketing Boolean @default(true)
  smsMarketing   Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business               Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments           Appointment[]
  appointmentPreferences AppointmentPreferences[]
  promotionUsage         PromotionUsage[]
  campaignRecipients     CampaignRecipient[]
  loyaltyMemberships     LoyaltyMembership[]
  reviews                ClientReview[]
  communicationHistory   CommunicationHistory[]
  PublicBookingAuditLog  PublicBookingAuditLog[]
  EmailPreference        EmailPreference[]

  @@unique([businessId, email])
  @@unique([businessId, phone])
  @@map("clients")
}

// ============================================================================
// APPOINTMENT & BOOKING SYSTEM
// ============================================================================

model Appointment {
  id         String  @id @default(cuid())
  businessId String
  clientId   String?
  staffId    String
  userId     String? // For walk-in appointments created by staff

  // Enhanced Appointment Details
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(SCHEDULED)

  // Multi-Service Support (Enhanced)
  totalDuration Int // Total duration in minutes
  totalPrice    Decimal @db.Decimal(10, 2)

  // Client Information (for walk-ins without client record)
  clientName  String?
  clientEmail String?
  clientPhone String?

  // Enhanced Booking Information
  notes         String?
  internalNotes String? // Staff-only notes
  depositAmount Decimal? @db.Decimal(10, 2)
  depositPaid   Boolean  @default(false)

  // Status Tracking
  confirmedAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (existing + enhanced)
  business              Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client                Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  staff                 Staff                      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  user                  User?                      @relation("AppointmentClient", fields: [userId], references: [id], onDelete: SetNull)
  services              AppointmentService[]
  transactions          Transaction[]
  productSales          ProductSale[]
  giftCardRedemptions   GiftCardRedemption[]
  promotionUsage        PromotionUsage[]
  loyaltyTransactions   LoyaltyTransaction[]
  reviews               ClientReview[]
  communicationHistory  CommunicationHistory[]
  statusHistory         AppointmentStatusHistory[]
  PublicBookingAuditLog PublicBookingAuditLog[]
  EmailQueue            EmailQueue[]

  @@index([businessId, startTime])
  @@index([staffId, startTime])
  @@index([businessId, status])
  @@index([clientId, startTime])
  @@map("appointments")
}

// Enhanced AppointmentService for better multi-service support
model AppointmentService {
  id            String @id @default(cuid())
  appointmentId String
  serviceId     String

  // Service details at time of booking (for historical accuracy)
  serviceName String
  price       Decimal @db.Decimal(10, 2)
  duration    Int // Duration in minutes

  // Service Order and Timing
  serviceOrder Int @default(1) // Order in multi-service appointment
  startOffset  Int @default(0) // Minutes from appointment start

  // Staff Assignment (for services requiring different staff)
  assignedStaffId String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assignedStaff Staff?      @relation("AssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@unique([appointmentId, serviceId])
  @@index([appointmentId, serviceOrder])
  @@map("appointment_services")
}

// Appointment status history for audit trail
model AppointmentStatusHistory {
  id            String @id @default(cuid())
  appointmentId String
  businessId    String

  oldStatus AppointmentStatus?
  newStatus AppointmentStatus
  changedBy String? // User ID who made the change
  reason    String?

  createdAt DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_history")
}

// Appointment preferences for repeat clients
model AppointmentPreferences {
  id         String @id @default(cuid())
  clientId   String
  businessId String

  preferredStaffId   String?
  preferredServices  String[] // Array of service IDs
  preferredTimeSlots Json // Preferred days/times
  specialRequests    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([clientId, businessId])
  @@map("appointment_preferences")
}

// ============================================================================
// FINANCIAL & TRANSACTION SYSTEM
// ============================================================================

model Transaction {
  id            String  @id @default(cuid())
  businessId    String
  appointmentId String?
  staffId       String?
  userId        String?

  // Transaction Details
  type     TransactionType
  status   TransactionStatus @default(PENDING)
  amount   Decimal           @db.Decimal(10, 2)
  currency String            @default("USD")

  // Payment Information
  paymentMethod PaymentMethod?
  paymentId     String? // External payment ID (Stripe, etc.)

  // Enhanced Employment Type Support
  staffEmploymentType   EmploymentType?
  commissionRate        Decimal?        @db.Decimal(5, 2)
  commissionAmount      Decimal?        @db.Decimal(10, 2)
  chairRentalApplicable Boolean         @default(false)

  // Metadata
  description String?
  metadata    Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([staffId, createdAt])
  @@index([businessId, staffEmploymentType])
  @@map("transactions")
}

// ============================================================================
// PAYMENT CALCULATIONS FOR HYBRID MODELS
// ============================================================================

model PaymentCalculation {
  id         String @id @default(cuid())
  businessId String
  staffId    String

  // Calculation Period
  calculationPeriodStart DateTime
  calculationPeriodEnd   DateTime

  // Employment Details
  employmentType EmploymentType

  // Financial Data
  grossRevenue       Decimal  @default(0) @db.Decimal(10, 2)
  commissionEarnings Decimal? @db.Decimal(10, 2) // For commission employees
  chairRentalDue     Decimal? @db.Decimal(10, 2) // For chair rental contractors
  baseSalaryAmount   Decimal? @db.Decimal(10, 2) // If applicable
  netEarnings        Decimal  @db.Decimal(10, 2)
  businessRetention  Decimal  @db.Decimal(10, 2)

  // Processing Status
  calculationDate DateTime @default(now())
  processed       Boolean  @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, calculationPeriodStart, calculationPeriodEnd])
  @@index([businessId, calculationPeriodStart])
  @@index([staffId, calculationPeriodStart])
  @@index([businessId, employmentType])
  @@map("payment_calculations")
}

// ============================================================================
// STAFF INVITATION SYSTEM
// ============================================================================

model StaffInvitation {
  id         String   @id @default(cuid())
  businessId String
  email      String
  invitedBy  String
  token      String   @unique
  expiresAt  DateTime

  // Invitation details
  role      BusinessRole @default(STAFF)
  staffData Json // Employment configuration and profile data
  message   String?

  // Status tracking
  status     InvitationStatus @default(PENDING)
  acceptedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inviter  User     @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([token])
  @@index([businessId])
  @@map("staff_invitations")
}

// ============================================================================
// BUSINESS OPERATIONS (PRODUCTS, PROMOTIONS, GIFT CARDS)
// ============================================================================

model Product {
  id         String @id @default(cuid())
  businessId String

  // Product Information
  name        String
  description String?
  category    String
  brand       String?
  sku         String? // Stock Keeping Unit

  // Pricing
  costPrice   Decimal? @db.Decimal(10, 2) // Cost to business
  retailPrice Decimal  @db.Decimal(10, 2) // Selling price

  // Inventory
  stockLevel    Int     @default(0)
  lowStockAlert Int?    @default(5) // Alert when stock falls below this level
  isActive      Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales    ProductSale[]

  @@unique([businessId, sku])
  @@index([businessId, category])
  @@map("products")
}

model ProductSale {
  id            String  @id @default(cuid())
  businessId    String
  productId     String
  appointmentId String?
  staffId       String?

  // Sale Details
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)

  // Sale Context
  saleType SaleType @default(RETAIL) // RETAIL or WITH_SERVICE

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([productId, createdAt])
  @@map("product_sales")
}

model GiftCard {
  id         String @id @default(cuid())
  businessId String

  // Gift Card Details
  code           String  @unique
  initialAmount  Decimal @db.Decimal(10, 2)
  currentBalance Decimal @db.Decimal(10, 2)

  // Purchase Information
  purchasedBy  String? // Client name or email
  purchaseDate DateTime @default(now())

  // Recipient Information
  recipientName  String?
  recipientEmail String?
  message        String?

  // Status and Expiry
  isActive   Boolean   @default(true)
  expiryDate DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  redemptions GiftCardRedemption[]

  @@index([businessId, isActive])
  @@map("gift_cards")
}

model GiftCardRedemption {
  id            String  @id @default(cuid())
  giftCardId    String
  appointmentId String?

  // Redemption Details
  amount         Decimal  @db.Decimal(10, 2)
  redeemedBy     String? // Client name
  redemptionDate DateTime @default(now())

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  giftCard    GiftCard     @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([giftCardId, redemptionDate])
  @@map("gift_card_redemptions")
}

model Promotion {
  id         String @id @default(cuid())
  businessId String

  // Promotion Details
  name        String
  description String?
  code        String? // Promo code (optional for automatic promotions)

  // Discount Configuration
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(10, 2) // Amount or percentage
  minimumSpend    Decimal?     @db.Decimal(10, 2)
  maximumDiscount Decimal?     @db.Decimal(10, 2) // For percentage discounts

  // Validity Period
  startDate DateTime
  endDate   DateTime

  // Usage Limits
  usageLimit     Int? // Total usage limit
  usageCount     Int  @default(0)
  perClientLimit Int? // Usage limit per client

  // Applicability
  applicableServices String[] // Service IDs (empty array means all services)
  newClientsOnly     Boolean  @default(false)

  // Status
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  usage    PromotionUsage[]

  @@unique([businessId, code])
  @@index([businessId, isActive, startDate, endDate])
  @@map("promotions")
}

model PromotionUsage {
  id            String  @id @default(cuid())
  promotionId   String
  appointmentId String?
  clientId      String?

  // Usage Details
  discountAmount Decimal  @db.Decimal(10, 2)
  usedAt         DateTime @default(now())

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  promotion   Promotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([promotionId, usedAt])
  @@index([clientId, usedAt])
  @@map("promotion_usage")
}

model MarketingCampaign {
  id         String @id @default(cuid())
  businessId String

  // Campaign Details
  name        String
  description String?
  type        CampaignType

  // Content
  subject String? // For email campaigns
  content String // Email HTML or SMS text

  // Targeting
  targetAudience Json // Criteria for targeting clients

  // Scheduling
  scheduledAt DateTime?
  sentAt      DateTime?

  // Status
  status CampaignStatus @default(DRAFT)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business             Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipients           CampaignRecipient[]
  communicationHistory CommunicationHistory[]

  @@index([businessId, type, status])
  @@map("marketing_campaigns")
}

model CampaignRecipient {
  id         String  @id @default(cuid())
  campaignId String
  clientId   String?

  // Recipient Details
  email String?
  phone String?
  name  String?

  // Delivery Status
  deliveryStatus DeliveryStatus @default(PENDING)
  deliveredAt    DateTime?

  // Engagement
  opened    Boolean   @default(false)
  openedAt  DateTime?
  clicked   Boolean   @default(false)
  clickedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client   Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([campaignId, deliveryStatus])
  @@index([clientId])
  @@map("campaign_recipients")
}

model LoyaltyProgram {
  id         String @id @default(cuid())
  businessId String

  // Program Details
  name        String
  description String?

  // Points Configuration
  pointsPerDollar      Decimal @default(1.00) @db.Decimal(5, 2) // Points earned per dollar spent
  pointsRedemptionRate Decimal @default(0.01) @db.Decimal(5, 2) // Dollar value per point

  // Tiers
  tiers Json // Array of tier configurations

  // Status
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  members  LoyaltyMembership[]

  @@map("loyalty_programs")
}

model LoyaltyMembership {
  id               String @id @default(cuid())
  loyaltyProgramId String
  clientId         String

  // Membership Details
  currentPoints Int     @default(0)
  totalEarned   Int     @default(0)
  totalRedeemed Int     @default(0)
  currentTier   String? // Tier name

  // Status
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  loyaltyProgram LoyaltyProgram       @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)
  client         Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions   LoyaltyTransaction[]

  @@unique([loyaltyProgramId, clientId])
  @@index([clientId, isActive])
  @@map("loyalty_memberships")
}

model LoyaltyTransaction {
  id                  String  @id @default(cuid())
  loyaltyMembershipId String
  appointmentId       String?

  // Transaction Details
  type        LoyaltyTransactionType
  points      Int // Positive for earning, negative for redemption
  description String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  membership  LoyaltyMembership @relation(fields: [loyaltyMembershipId], references: [id], onDelete: Cascade)
  appointment Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([loyaltyMembershipId, createdAt])
  @@map("loyalty_transactions")
}

model ClientReview {
  id            String  @id @default(cuid())
  businessId    String
  clientId      String
  appointmentId String?
  staffId       String?

  // Review Details
  rating        Int // 1-5 star rating
  serviceRating Int? // Optional separate service rating
  staffRating   Int? // Optional separate staff rating
  comment       String?

  // Review Context
  serviceType String? // Which service was reviewed
  isVerified  Boolean @default(false) // Verified purchase/appointment
  isPublic    Boolean @default(true) // Public display permission

  // Response
  businessResponse String? // Business reply to review
  respondedAt      DateTime? // When business responded

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staff       Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([businessId, rating])
  @@index([staffId, rating])
  @@index([businessId, createdAt])
  @@map("client_reviews")
}

model CommunicationHistory {
  id         String @id @default(cuid())
  businessId String
  clientId   String

  // Communication Details
  type      CommunicationType
  direction CommunicationDirection
  channel   CommunicationChannel
  subject   String?
  content   String

  // Delivery and Engagement
  status      CommunicationStatus @default(SENT)
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  respondedAt DateTime?

  // Context
  campaignId     String? // If part of a marketing campaign
  appointmentId  String? // If related to an appointment
  automationType AutomationType? // If automated communication

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign    MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  appointment Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([businessId, clientId, createdAt])
  @@index([businessId, type, createdAt])
  @@index([clientId, createdAt])
  @@map("communication_history")
}

// ============================================================================
// EMAIL NOTIFICATION SYSTEM
// ============================================================================

model EmailTemplate {
  id           String  @id @default(cuid())
  businessId   String?
  type         String
  name         String
  subject      String
  htmlTemplate String  @db.Text
  textTemplate String  @db.Text
  variables    Json    @default("[]")
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type])
  @@index([type])
  @@index([businessId, isActive])
  @@map("email_templates")
}

model EmailPreference {
  id                    String    @id @default(cuid())
  businessId            String
  clientId              String?
  email                 String
  receiveConfirmations  Boolean   @default(true)
  receiveReminders      Boolean   @default(true)
  receiveCancellations  Boolean   @default(true)
  receiveMarketing      Boolean   @default(false)
  unsubscribedAt        DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([email])
  @@index([businessId, clientId])
  @@map("email_preferences")
}

model EmailQueue {
  id             String  @id @default(cuid())
  businessId     String
  appointmentId  String?
  recipientEmail String
  recipientName  String?
  templateType   String
  subject        String
  htmlContent    String  @db.Text
  textContent    String  @db.Text
  priority       String  @default("normal") // high, normal, low
  status         String  @default("pending") // pending, processing, sent, failed
  attemptCount   Int     @default(0)
  maxAttempts    Int     @default(3)
  scheduledAt    DateTime @default(now())
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  failureReason  String?
  messageId      String? // External provider message ID
  metadata       Json    @default("{}")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([scheduledAt, status])
  @@index([priority, status])
  @@index([appointmentId])
  @@index([businessId, createdAt])
  @@map("email_queue")
}

model ReminderConfig {
  id                  String  @id @default(cuid())
  businessId          String  @unique
  enable24hReminders  Boolean @default(true)
  enable2hReminders   Boolean @default(false)
  quietHoursStart     String? // HH:MM format (e.g., "22:00")
  quietHoursEnd       String? // HH:MM format (e.g., "08:00")
  timezone            String  @default("America/New_York")
  customReminderTimes Json?   // Future: custom reminder timing

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("reminder_configs")
}

// ============================================================================
// CALENDAR INFRASTRUCTURE & AVAILABILITY MANAGEMENT
// ============================================================================

model BusinessHours {
  id         String  @id @default(cuid())
  businessId String
  dayOfWeek  Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  openTime   String? // Time in HH:MM format
  closeTime  String? // Time in HH:MM format
  isClosed   Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId, dayOfWeek])
  @@map("business_hours")
}

model BusinessHoliday {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime @db.Date
  name       String?
  isClosed   Boolean  @default(true)
  openTime   String? // Time in HH:MM format for special hours
  closeTime  String? // Time in HH:MM format for special hours

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId, date])
  @@map("business_holidays")
}

model StaffAvailability {
  id            String    @id @default(cuid())
  staffId       String
  businessId    String
  dayOfWeek     Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime     String // Time in HH:MM format
  endTime       String // Time in HH:MM format
  isRecurring   Boolean   @default(true)
  effectiveDate DateTime? @db.Date // When this availability starts
  expiryDate    DateTime? @db.Date // When this availability ends

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
  @@index([businessId])
  @@index([effectiveDate, expiryDate])
  @@map("staff_availability")
}

model StaffAvailabilityOverride {
  id          String   @id @default(cuid())
  staffId     String
  businessId  String
  date        DateTime @db.Date
  startTime   String? // Time in HH:MM format, null if unavailable
  endTime     String? // Time in HH:MM format, null if unavailable
  isAvailable Boolean  @default(true)
  reason      String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([staffId, date])
  @@index([businessId])
  @@map("staff_availability_overrides")
}

model TimeOffRequest {
  id           String        @id @default(cuid())
  staffId      String
  businessId   String
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  reason       String?
  status       TimeOffStatus @default(PENDING)
  approvedBy   String? // Staff ID of approver
  approvedAt   DateTime?
  denialReason String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  approver Staff?   @relation("TimeOffApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([staffId, startDate, endDate])
  @@index([businessId, status])
  @@index([approvedBy, approvedAt])
  @@map("time_off_requests")
}

model AvailabilityCache {
  id             String   @id @default(cuid())
  businessId     String
  staffId        String?
  date           DateTime @db.Date
  availableSlots Json // Array of available time slots
  cacheKey       String   @unique
  expiresAt      DateTime

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([businessId, date])
  @@index([staffId, date])
  @@index([expiresAt])
  @@map("availability_cache")
}

// ============================================================================
// BUSINESS HOURS & PUBLIC BOOKING
// ============================================================================

model PublicBookingConfig {
  id         String @id @default(cuid())
  businessId String @unique

  // Booking Settings
  isEnabled             Boolean @default(false)
  advanceBookingDays    Int     @default(30)
  minimumNoticeHours    Int     @default(2)
  maxServicesPerBooking Int     @default(3)

  // Client Requirements
  requirePhone Boolean @default(true)
  requireEmail Boolean @default(true)
  allowNotes   Boolean @default(true)

  // Branding
  customDomain String?
  brandColors  Json? // { primary, secondary, accent }

  // Notifications
  sendConfirmationEmail Boolean @default(true)
  sendReminderEmail     Boolean @default(true)
  reminderHours         Int     @default(24)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("public_booking_configs")
}

