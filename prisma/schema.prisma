// ============================================================================
// SECURITY & AUDIT LOGGING
// ============================================================================

model SecurityLog {
  id              String                @id @default(cuid())
  type            SecurityViolationType
  userId          String?
  businessId      String?
  resourceId      String?
  resourceType    String
  attemptedAction String
  details         Json?
  ipAddress       String?
  userAgent       String?
  requestId       String?
  severity        String                @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([severity, createdAt])
  @@index([resourceType, resourceId])
  @@map("security_logs")
}

model AuditLog {
  id           String  @id @default(cuid())
  userId       String
  businessId   String
  action       String
  resourceType String
  resourceId   String?
  oldValues    Json?
  newValues    Json?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  requestId    String?

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ============================================================================
// MONITORING & ANALYTICS
// ============================================================================

model PerformanceMetric {
  id            String   @id @default(cuid())
  operationType String
  duration      Float // Duration in milliseconds
  businessId    String
  success       Boolean
  timestamp     DateTime
  metadata      Json?

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, timestamp])
  @@index([operationType, timestamp])
  @@index([success, timestamp])
  @@map("performance_metrics")
}

model SystemAlert {
  id         String    @id @default(cuid())
  type       String
  severity   String
  data       Json
  timestamp  DateTime
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, timestamp])
  @@index([severity, resolved])
  @@index([timestamp])
  @@map("system_alerts")
}

model BusinessMetric {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime
  type       String
  value      Float
  metadata   Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date, type], name: "businessId_date_type")
  @@index([businessId, date])
  @@index([type, date])
  @@map("business_metrics")
}

// ============================================================================
// STAFF NOTIFICATIONS
// ============================================================================

model StaffNotification {
  id         String                    @id @default(cuid())
  businessId String
  staffId    String
  type       StaffNotificationType
  title      String
  message    String
  metadata   Json?
  isRead     Boolean                   @default(false)
  priority   StaffNotificationPriority @default(NORMAL)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, staffId, isRead])
  @@index([businessId, staffId, createdAt])
  @@index([staffId, isRead])
  @@map("staff_notifications")
}

// ============================================================================
// PUBLIC BOOKING AUDIT LOGGING
// ============================================================================

model PublicBookingAuditLog {
  id            String  @id @default(cuid())
  event         String // PublicBookingAuditEvent enum value
  businessId    String
  sessionId     String?
  clientId      String?
  appointmentId String?

  // Request context
  ipAddress String?
  userAgent String?
  referer   String?
  requestId String?

  // Event data
  eventData Json?

  // Performance metrics
  responseTime Int? // milliseconds

  // Security context
  securityFlags String[] // Array of security flags
  riskScore     Int      @default(0) // 0-100 risk score
  riskLevel     String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL

  // Error information
  errorType    String?
  errorMessage String?
  stackTrace   String? @db.Text

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([event, createdAt])
  @@index([riskLevel, createdAt])
  @@index([sessionId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("public_booking_audit_logs")
}

enum StaffNotificationType {
  NEW_BOOKING
  BOOKING_CANCELLED
  BOOKING_MODIFIED
  SCHEDULE_CHANGE
  PAYMENT_RECEIVED
  CLIENT_MESSAGE
  SYSTEM_ALERT
  REMINDER
}

enum StaffNotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============================================================================
// ANALYTICS & MONITORING SYSTEM
// ============================================================================

model BookingAnalyticsEvent {
  id         String   @id @default(cuid())
  businessId String
  eventType  String // booking_started, service_selected, time_selected, form_submitted, booking_completed, booking_abandoned
  sessionId  String
  timestamp  DateTime
  metadata   Json     @default("{}")
  userId     String?
  clientId   String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, eventType, timestamp])
  @@index([sessionId, timestamp])
  @@map("booking_analytics_events")
}

model BookingPerformanceEvent {
  id         String   @id @default(cuid())
  businessId String
  eventType  String // page_load, api_response, error, user_interaction
  duration   Float? // Duration in milliseconds
  timestamp  DateTime
  metadata   Json     @default("{}")

  // Error details
  errorMessage String?
  errorStack   String?
  errorCode    String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, eventType, timestamp])
  @@index([businessId, timestamp])
  @@map("booking_performance_events")
}

model BookingError {
  id         String   @id @default(cuid())
  businessId String
  errorType  String // validation, availability, payment, system, network
  severity   String // low, medium, high, critical
  message    String
  stack      String?
  context    Json     @default("{}")
  userId     String?
  sessionId  String?
  timestamp  DateTime

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, errorType, severity, timestamp])
  @@index([businessId, timestamp])
  @@map("booking_errors")
}

model BookingAlertRule {
  id         String  @id @default(cuid())
  businessId String
  name       String
  condition  Json // { errorType?, severity?, threshold: number, timeWindow: number }
  actions    Json // { email?: string[], webhook?: string, sms?: string[] }
  isActive   Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  alerts BookingAlert[]

  @@index([businessId, isActive])
  @@map("booking_alert_rules")
}

model BookingAlert {
  id         String   @id @default(cuid())
  businessId String
  ruleId     String
  ruleName   String
  errorType  String
  severity   String
  message    String
  context    Json     @default("{}")
  timestamp  DateTime

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rule BookingAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([businessId, timestamp])
  @@index([ruleId, timestamp])
  @@map("booking_alerts")
}
