{
  "extends": [
    "next/core-web-vitals",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "react", "react-hooks"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    // RATCHET
    // ESLint now runs as part of `next build`, so any rule set to "error"
    // blocks the build. These rules currently have too many violations to
    // enforce (measured: 123 unused-vars, 29 unescaped-entities, 4 require-
    // imports, 2 assign-module-variable, 1 empty-object-type, 530 explicit-
    // any). They are "warn" so the gate passes today and the violations stay
    // visible. Raise each to "error" as its count reaches zero - a rule that
    // fails 159 times is the same as no rule at all.
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-require-imports": "warn",
    "@typescript-eslint/no-empty-object-type": "warn",
    "react/no-unescaped-entities": "warn",
    "@next/next/no-assign-module-variable": "warn",
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "warn",
    // React specific rules
    // (overrides below add rules scoped to particular directories)
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    // General code quality
    "no-console": "warn",
    "no-debugger": "error",
    "prefer-const": "error",
    "no-var": "error",
    // Import organization
    "sort-imports": [
      "error",
      {
        "ignoreCase": false,
        "ignoreDeclarationSort": true,
        "ignoreMemberSort": false,
        "memberSyntaxSortOrder": ["none", "all", "multiple", "single"],
        "allowSeparatedGroups": true
      }
    ]
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "overrides": [
    {
      "files": ["app/api/**/*.ts"],
      "rules": {
        // Data access belongs in lib/repositories, not inline in a route
        // handler. 56 of 80 routes import prisma directly while 15 use the
        // repository layer, so neither pattern is currently trustworthy.
        // "warn" while booking-loop routes migrate; raise to "error" at zero.
        "no-restricted-imports": [
          "warn",
          {
            "paths": [
              {
                "name": "@/lib/prisma",
                "message": "Use a repository in lib/repositories/ rather than querying Prisma directly from a route handler. See CLAUDE.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.tsx"],
      "rules": {
        // Colours come from lib/design/tokens.ts. Raw hex in components is
        // exactly what let four competing sources of design truth drift apart.
        "no-restricted-syntax": [
          "warn",
          {
            "selector": "Literal[value=/^#(?:[0-9a-fA-F]{3}){1,2}$/]",
            "message": "No raw hex colours in components. Import from lib/design/tokens.ts or use a Tailwind class."
          }
        ]
      }
    }
  ]
}
