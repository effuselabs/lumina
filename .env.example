# Lumina environment variables
#
# Local development:  cp .env.example .env
# `.env` is gitignored. Never commit real secrets, and never reuse a local
# secret in a deployed environment.
#
# Staging and production set these in the Railway dashboard, not in a file.
# See docs/environments.md.

# ---------------------------------------------------------------------------
# Required — the app will not boot without these
# ---------------------------------------------------------------------------

# Postgres. The local default matches docker-compose.yml.
# On Railway this is provided by the Postgres plugin as ${{Postgres.DATABASE_URL}};
# never paste a literal connection string there.
DATABASE_URL="postgresql://lumina:lumina_dev_password@localhost:5432/lumina_dev"

# NextAuth session signing key. Generate a UNIQUE value per environment:
#   openssl rand -base64 32
# Sharing one secret across environments means a staging session token is
# also valid in production.
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Canonical origin of this environment. Must match the browser URL exactly or
# auth callbacks and cookie domains break.
#   local       http://localhost:3000
#   staging     https://staging.uselumina.app
#   production  https://uselumina.app
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email — required for the booking loop (confirmations and reminders)
# ---------------------------------------------------------------------------

# https://resend.com/api-keys
# Safe to leave blank locally: the email provider is resolved lazily, so an
# absent key disables sending without breaking the build.
RESEND_API_KEY=""

# Sending identity. The domain must be verified in Resend before it will send.
EMAIL_FROM="noreply@uselumina.app"
EMAIL_FROM_NAME="Lumina"

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------

# Shared secret for POST /api/cron/reminders. The handler rejects any request
# whose Authorization header is not exactly `Bearer ${CRON_SECRET}`.
#   openssl rand -hex 32
# If this is unset the endpoint returns 500 and reminders never send.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Error tracking — staging and production only, intentionally blank locally
# ---------------------------------------------------------------------------

# An empty SENTRY_DSN disables Sentry entirely, including its build plugin.
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT="lumina"
# Only needed where source maps are uploaded (deploy). Not needed locally.
SENTRY_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# Post-MVP — dependencies installed, feature parked. Leave blank.
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
