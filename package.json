{
  "name": "lumina",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent Software for Small Business Growth - AI-powered business management platform for salons and barbershops",
  "author": "Effuse Labs",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:integration": "jest --testMatch='**/*.integration.test.{js,ts,tsx}'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "docker:dev": "docker-compose up --build",
    "docker:dev:detached": "docker-compose up --build -d",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "ci:install": "npm ci",
    "ci:build": "npm run build",
    "ci:test": "npm run test:coverage && npm run test:e2e",
    "ci:lint": "npm run lint && npm run format:check && npm run type-check",
    "deploy:staging": "railway up --service lumina-staging",
    "deploy:production": "railway up --service lumina-prod",
    "health:check": "curl -f http://localhost:3000/api/health || exit 1",
    "analyze-steering-impact": "tsx scripts/analyze-steering-impact.ts",
    "modernize-plan": "tsx scripts/modernize-development-plan.ts",
    "ai:init-context": "tsx scripts/init-ai-context.ts",
    "ai:context-report": "tsx scripts/init-ai-context.ts --report --verbose",
    "project:update-state": "tsx scripts/update-project-state.ts",
    "decisions:add": "tsx scripts/manage-decisions.ts add",
    "decisions:list": "tsx scripts/manage-decisions.ts list",
    "decisions:summary": "tsx scripts/manage-decisions.ts summary",
    "daily-status": "tsx scripts/manage-daily-status.ts",
    "daily-status:generate": "tsx scripts/generate-daily-status.ts",
    "daily-status:init": "tsx scripts/manage-daily-status.ts init",
    "daily-status:report": "tsx scripts/manage-daily-status.ts report",
    "daily-status:weekly": "tsx scripts/manage-daily-status.ts weekly",
    "daily-status:dashboard": "tsx scripts/manage-daily-status.ts dashboard",
    "daily-status:linear": "tsx scripts/daily-status-linear.ts",
    "blocker:add": "tsx scripts/daily-status-linear.ts add-blocker",
    "blocker:resolve": "tsx scripts/daily-status-linear.ts resolve-blocker",
    "blocker:list": "tsx scripts/daily-status-linear.ts list-blockers",
    "decision:add": "tsx scripts/daily-status-linear.ts add-decision",
    "linear:sync": "tsx scripts/daily-status-linear.ts sync",
    "linear:report": "tsx scripts/daily-status-linear.ts report",
    "linear:test": "tsx scripts/test-linear-integration.ts",
    "audit:docs": "tsx scripts/comprehensive-documentation-audit.ts",
    "audit:docs:dry-run": "tsx scripts/comprehensive-documentation-audit.ts --dry-run --verbose",
    "audit:docs:plan-only": "tsx scripts/comprehensive-documentation-audit.ts --skip-migration --verbose",
    "quality-audit": "tsx scripts/quality-audit.ts",
    "quality-audit:create-issues": "tsx scripts/quality-audit.ts --create-issues",
    "quality-audit:verbose": "tsx scripts/quality-audit.ts --verbose",
    "cleanup-docs": "tsx scripts/cleanup-documentation.ts",
    "cleanup-docs:execute": "tsx scripts/cleanup-documentation.ts --execute"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^5.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.1.5",
    "@react-email/components": "^0.5.1",
    "@react-email/render": "^1.2.1",
    "@sentry/nextjs": "^10.5.0",
    "@sentry/node": "^10.5.0",
    "@sentry/react": "^10.5.0",
    "@stripe/react-stripe-js": "^3.9.2",
    "@stripe/stripe-js": "^2.4.0",
    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "commander": "^12.0.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.14",
    "lucide-react": "^0.303.0",
    "next": "^14.0.4",
    "next-auth": "^5.0.0-beta.29",
    "nodemailer": "^6.10.1",
    "react": "^18.2.0",
    "react-day-picker": "^9.9.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.5.2",
    "react-hook-form": "^7.48.2",
    "react-intersection-observer": "^9.16.0",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "stripe": "^14.12.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/react-grid-layout": "^1.3.5",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "prisma": "^5.7.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
