{
  "name": "lumina",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent Software for Small Business Growth - AI-powered business management platform for salons and barbershops",
  "author": "Effuse Labs",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --selectProjects unit --coverage=false --ci __tests__/design/contrast.test.ts __tests__/security/public-booking-email-sanitizer.test.ts __tests__/security/public-booking-abuse-detector.test.ts __tests__/factories/transaction-factory-staff-mix.test.ts __tests__/factories/reset-demo-data.test.ts __tests__/lib/repositories/appointment-repository.test.ts __tests__/lib/services/time-slot-analysis-engine.test.ts __tests__/analytics/appointment-analytics-service.test.ts __tests__/monitoring/business-metrics-tracker.test.ts",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:unit": "jest --testPathIgnorePatterns=e2e",
    "test:integration": "jest --testMatch='**/*.integration.test.{js,ts,tsx}'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:visual": "playwright test --config=e2e/visual-test.config.ts",
    "test:visual:ui": "playwright test --config=e2e/visual-test.config.ts --ui",
    "test:visual:update": "playwright test --config=e2e/visual-test.config.ts --update-snapshots",
    "test:visual:headed": "playwright test --config=e2e/visual-test.config.ts --headed",
    "test:visual:setup": "tsx scripts/setup-design-system-visual-baselines.ts",
    "test:accessibility": "tsx scripts/run-accessibility-tests.ts",
    "test:performance": "playwright test e2e/performance/",
    "test:comprehensive": "tsx scripts/run-comprehensive-tests.ts",
    "test:comprehensive:verbose": "tsx scripts/run-comprehensive-tests.ts --verbose",
    "test:comprehensive:required": "tsx scripts/run-comprehensive-tests.ts --required-only",
    "test:design-system": "tsx scripts/run-comprehensive-design-system-tests.ts",
    "test:design-system:required": "tsx scripts/run-comprehensive-design-system-tests.ts --required-only",
    "test:cross-browser": "tsx scripts/run-cross-browser-tests.ts",
    "test:validate-setup": "tsx scripts/validate-test-setup.ts",
    "test:validate-setup:verbose": "tsx scripts/validate-test-setup.ts --verbose",
    "test:analytics-quality": "tsx scripts/validate-analytics-data-quality.ts",
    "test:booking-qa": "tsx scripts/run-booking-qa-tests.ts",
    "test:booking-integration": "jest __tests__/integration/public-booking-workflow.test.tsx --verbose",
    "test:booking-performance": "jest __tests__/performance/concurrent-booking.test.ts --verbose",
    "test:booking-accessibility": "jest __tests__/accessibility/public-booking-a11y.test.tsx --verbose",
    "test:booking-e2e": "playwright test e2e/public-booking-e2e.spec.ts",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:visual",
    "test:appointments": "tsx scripts/run-appointment-tests.ts",
    "test:appointments:unit": "tsx scripts/run-appointment-tests.ts --suite unit",
    "test:appointments:integration": "tsx scripts/run-appointment-tests.ts --suite integration",
    "test:appointments:performance": "tsx scripts/run-appointment-tests.ts --suite performance",
    "test:appointments:accessibility": "tsx scripts/run-appointment-tests.ts --suite accessibility",
    "test:appointments:e2e": "tsx scripts/run-appointment-tests.ts --suite e2e",
    "test:appointments:mobile": "tsx scripts/run-appointment-tests.ts --suite mobile-e2e",
    "test:appointments:watch": "tsx scripts/run-appointment-tests.ts --suite unit --watch",
    "test:appointments:coverage": "tsx scripts/run-appointment-tests.ts --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:reset": "npx tsx --env-file-if-exists=.env prisma/reset-demo-data.ts",
    "db:seed:refresh": "npm run db:seed:reset && npm run db:seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "seed:manage": "tsx scripts/manage-seed-data.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"try{require('husky').install()}catch{}\"",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "ci:install": "npm ci",
    "ci:build": "npm run build",
    "ci:test": "npm run test:coverage && npm run test:e2e",
    "ci:lint": "npm run lint && npm run format:check && npm run type-check",
    "deploy:staging": "railway up --service lumina-staging",
    "deploy:production": "railway up --service lumina-prod",
    "health:check": "curl -f http://localhost:3000/api/health || exit 1",
    "migrate:calendar-data": "tsx scripts/migrate-calendar-data.ts",
    "migrate:calendar-data:status": "tsx scripts/migrate-calendar-data.ts --status",
    "migrate:calendar-data:dry-run": "tsx scripts/migrate-calendar-data.ts --dry-run",
    "migrate:calendar-data:rollback": "tsx scripts/migrate-calendar-data.ts --rollback",
    "compat:status": "tsx scripts/manage-backward-compatibility.ts status",
    "compat:candidates": "tsx scripts/manage-backward-compatibility.ts candidates",
    "compat:migrate-business": "tsx scripts/manage-backward-compatibility.ts migrate-business",
    "compat:migrate-staff": "tsx scripts/manage-backward-compatibility.ts migrate-staff",
    "compat:migrate-all": "tsx scripts/manage-backward-compatibility.ts migrate-all",
    "compat:test-fallback": "tsx scripts/manage-backward-compatibility.ts test-fallback"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^0.5.1",
    "@react-email/render": "^1.2.1",
    "@sentry/nextjs": "^10.5.0",
    "@sentry/node": "^10.5.0",
    "@sentry/react": "^10.5.0",
    "@stripe/react-stripe-js": "^3.9.2",
    "@stripe/stripe-js": "^2.4.0",
    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/luxon": "^3.7.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "commander": "^12.0.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.14",
    "isomorphic-dompurify": "^2.28.0",
    "lucide-react": "^0.303.0",
    "luxon": "^3.7.2",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.32",
    "react": "^18.2.0",
    "react-day-picker": "^9.9.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.5.2",
    "react-hook-form": "^7.48.2",
    "react-intersection-observer": "^9.16.0",
    "recharts": "^3.2.1",
    "resend": "^6.3.0",
    "sonner": "^2.0.7",
    "stripe": "^14.12.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.4",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@faker-js/faker": "^10.0.0",
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.8",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/react-grid-layout": "^1.3.5",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "autoprefixer": "^10.4.16",
    "axe-core": "^4.10.3",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "ioredis": "^5.8.2",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-mock-extended": "^4.0.0",
    "lint-staged": "^15.2.0",
    "msw": "^2.11.6",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "prisma": "^5.7.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
