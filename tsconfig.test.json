{
  // Type-checks test and E2E sources, which tsconfig.json deliberately excludes
  // so that a broken test config can never block `next build`.
  // Run with: npx tsc -p tsconfig.test.json --noEmit
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "jest", "@testing-library/jest-dom"]
  },
  "include": [
    "next-env.d.ts",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "__mocks__/**/*.ts",
    "test-utils/**/*.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "exclude": ["node_modules", ".next", "dist", "build"]
}
