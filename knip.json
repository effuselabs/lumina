{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/{page,layout,route,error,loading,not-found,template,default}.{ts,tsx}",
    "auth.ts",
    "auth.config.ts",
    "e2e/**/*.spec.ts",
    "__tests__/**/*.test.{ts,tsx}",
    "scripts/**/*.{ts,js}"
  ],
  "ignore": [".railway/railway.ts", "public/**"],
  "ignoreDependencies": ["husky", "railway"],
  "ignoreBinaries": ["docker-compose", "railway"],
  "ignoreIssues": {
    "components/ui/{alert-dialog,dialog,dropdown-menu,select,table}.tsx": [
      "exports"
    ],
    "lib/design/tokens.ts": ["exports"],
    "lib/stripe.ts": ["exports", "types"],
    "lib/financial/**": ["exports", "types"],
    "components/payments/**": ["exports", "types"]
  }
}
